{
  "name": "parkassist-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React MCP App and Copilot Studio tools for the 5 Bell parking garage.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:widget && npm run build:genui && npm run build:server",
    "build:widget": "cross-env INPUT=mcp-app.html vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "clean": "rimraf dist",
    "dev": "npm run build:widget && tsx watch src/server/index.ts",
    "start": "node dist/server/server/index.js",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "release:check": "node scripts/check-release-readiness.mjs",
    "release:metadata": "node scripts/set-release-metadata.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build:genui": "cross-env INPUT=genui.html vite build"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.90",
    "@ai-sdk/react": "^4.0.130",
    "@azure/identity": "^4.12.0",
    "@azure/msal-browser": "^5.24.0",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.319",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ai": "^7.0.127",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "cross-env": "^10.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.3"
  }
}
