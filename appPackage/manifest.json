{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
  "manifestVersion": "1.24",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Castleton",
    "websiteUrl": "${{PUBLISHER_WEBSITE_URL}}",
    "privacyUrl": "${{PRIVACY_URL}}",
    "termsOfUseUrl": "${{TERMS_OF_USE_URL}}"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "ParkAssist Copilot${{APP_NAME_SUFFIX}}",
    "full": "ParkAssist Garage Operations Copilot"
  },
  "description": {
    "short": "Live parking, plate, and camera-feed assistance for 5 Bell.",
    "full": "Ask about available parking spaces, locate an authorized license plate, or review stale camera feeds with inline snapshot previews from the 5 Bell garage."
  },
  "accentColor": "#0078D4",
  "composeExtensions": [],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "parkAssistAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity"
  ],
  "validDomains": [
    "${{MCP_SERVER_HOST}}"
  ],
  "webApplicationInfo": {
    "id": "${{ENTRA_CLIENT_ID}}",
    "resource": "api://${{ENTRA_CLIENT_ID}}"
  }
}
