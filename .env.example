# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins allowed to call the Entra-protected /api/* routes.
CORS_ALLOWED_ORIGINS=
PARKASSIST_API_BASE_URL=https://parkassistproxy99b.azurewebsites.net/api
PARKING_GARAGE=5 Bell
STALE_AFTER_MINUTES=15
CACHE_SECONDS=30
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# Protect /mcp. Use none only for local development.
AUTH_MODE=none
MCP_API_KEY=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_REQUIRED_SCOPE=access_as_user
# Comma-separated token audiences accepted in addition to the client ID and
# api://<client-id>. Include the Developer Portal SSO Application ID URI.
ENTRA_ALLOWED_AUDIENCES=

# Signs short-lived camera snapshot URLs returned to the widget. Replace this
# placeholder before production; startup requires a non-placeholder 32+ byte value.
CAMERA_SIGNING_SECRET=replace-with-at-least-32-random-characters
CAMERA_URL_TTL_SECONDS=300

# Optional SensorHealth overlay from SharePoint via Microsoft Graph.
# DefaultAzureCredential uses these values locally and managed identity in Azure.
SHAREPOINT_SITE_URL=https://castletonstage.sharepoint.com/sites/Development
SHAREPOINT_LIST_NAME=SensorHealth
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
