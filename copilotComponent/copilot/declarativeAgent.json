{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/declarative-agent/v1.8/schema.json",
  "version": "v1.8",
  "name": "ParkAssist Garage",
  "description": "Live occupancy, availability, plate lookup, and camera health for the 5 Bell parking garage.",
  "instructions": "$[file('instruction.txt')]",
  "conversation_starters": [
    {
      "title": "Garage overview",
      "text": "How is the 5 Bell garage looking right now?"
    },
    {
      "title": "Find parking",
      "text": "Show available spaces on floor 5."
    },
    {
      "title": "Stale camera feeds",
      "text": "Which cameras have stale feeds?"
    },
    {
      "title": "Find a plate",
      "text": "Where is plate ABC123 parked?"
    }
  ],
  "actions": [
    {
      "id": "parkAssistGarageAction",
      "file": "ai-plugin.json"
    }
  ]
}
