{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "stale-camera-feeds-copilot-component": {
      "components": [
        {
          "entrypoint": "./lib/copilotComponents/staleCameraFeeds/StaleCameraFeedsCopilotComponent.js",
          "manifest": "./src/copilotComponents/staleCameraFeeds/StaleCameraFeedsCopilotComponent.manifest.json"
        }
      ]
    },
    "garage-overview-copilot-component": {
      "components": [
        {
          "entrypoint": "./lib/copilotComponents/garageOverview/GarageOverviewCopilotComponent.js",
          "manifest": "./src/copilotComponents/garageOverview/GarageOverviewCopilotComponent.manifest.json"
        }
      ]
    },
    "available-spaces-copilot-component": {
      "components": [
        {
          "entrypoint": "./lib/copilotComponents/availableSpaces/AvailableSpacesCopilotComponent.js",
          "manifest": "./src/copilotComponents/availableSpaces/AvailableSpacesCopilotComponent.manifest.json"
        }
      ]
    },
    "plate-search-copilot-component": {
      "components": [
        {
          "entrypoint": "./lib/copilotComponents/plateSearch/PlateSearchCopilotComponent.js",
          "manifest": "./src/copilotComponents/plateSearch/PlateSearchCopilotComponent.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "StaleCameraFeedsCopilotComponentStrings": "lib/copilotComponents/staleCameraFeeds/loc/{locale}.js",
    "GarageOverviewCopilotComponentStrings": "lib/copilotComponents/garageOverview/loc/{locale}.js",
    "AvailableSpacesCopilotComponentStrings": "lib/copilotComponents/availableSpaces/loc/{locale}.js",
    "PlateSearchCopilotComponentStrings": "lib/copilotComponents/plateSearch/loc/{locale}.js"
  }
}
